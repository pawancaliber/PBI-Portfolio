model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Customer","Date","Product","Reseller","SalesOrder","SalesTerritory","Sales","Measure Table","Table1","RangeStart","RangeEnd","gold dim_customer"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customer
ref table Date
ref table Product
ref table Reseller
ref table SalesOrder
ref table SalesTerritory
ref table Sales
ref table category/product
ref table salesamount/cost
ref table 'Measure Table'
ref table Table1
ref table 'gold dim_customer'

ref role ManagerROle

ref cultureInfo en-US

